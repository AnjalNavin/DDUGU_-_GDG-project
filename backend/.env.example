# Copy this file to `.env` and adjust the values.
# The application reads environment variables first, then `.env`.

# PostgreSQL connection string for the application.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ddugu

# Secret used to sign JWT access tokens. Generate a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ALGORITHM=HS256

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8123,http://127.0.0.1:8123

# Optional bootstrap administrator. Only created when both values are set and
# only if the email does not already exist. Never commit a real password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-bootstrap-password
ADMIN_FULL_NAME=System Administrator

# Booking window enforced by the API (24-hour clock, whole hours).
FIRST_BOOKING_HOUR=7
LAST_BOOKING_HOUR=21

# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ddugu_test
